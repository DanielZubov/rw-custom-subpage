# ============================================================
# LeonVPN Subscription Page — переменные окружения
# Скопируйте этот файл в .env и заполните под свою панель.
# ============================================================

# Порт, на котором слушает контейнер (по умолчанию как у штатной
# remnawave/subscription-page — 3010, чтобы проще было заменить в реверс-прокси)
PORT=3010

# ---- Remnawave API -------------------------------------------------
# Базовый адрес backend-панели Remnawave, БЕЗ пути /api и БЕЗ слэша в конце.
# Обычно это внутренний адрес панели в docker-сети, например http://remnawave:3000,
# либо публичный https://panel.leonvpn.example, если панель наружу торчит напрямую.
REMNAWAVE_API_URL=http://remnawave:3000

# API-токен админа панели (Panel -> Settings -> API Tokens, роль с доступом на чтение
# пользователей достаточно). Токен используется ТОЛЬКО на сервере — в браузер
# никогда не уходит. Нужен, чтобы по shortUuid узнать tag и активные Internal Squad'ы
# пользователя и решить, показывать ли вкладку "Роутер".
REMNAWAVE_API_TOKEN=REPLACE_ME

# Публичный домен+путь подписки — то же самое значение, что вы прописали в
# SUB_PUBLIC_DOMAIN панели (.env самой Remnawave). Используется только для того,
# чтобы построить и показать пользователю правильную ссылку на подписку.
# Формат: домен/путь, БЕЗ https:// и БЕЗ слэша в конце.
SUB_PUBLIC_DOMAIN=sub.leonvpn.example

# ---- Определение "роутерных" пользователей --------------------------
# Ключевое слово, которое ищем (без учёta регистра) в tag пользователя
# и в названиях его активных Internal Squad'ов. Если совпало — показываем
# вкладку OpenWRT / Podkop / Forkop. Можно поменять и в веб-админке.
ROUTER_KEYWORD=ROUTER

# ---- Админ-панель (/admin) ------------------------------------------
# HTTP Basic Auth. Обязательно смените пароль перед продакшеном и держите
# страницу за HTTPS (реверс-прокси/Caddy).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please

# Часовой пояс для отображения дат окончания подписки
TZ=Europe/Warsaw
